+  /** Actual client-side crosshair selection (not an inferred X-ray scan).
+   *  Vanilla client.hitResult is updated by the game renderer before MCio
+   *  captures its current frame. Target position is returned ONLY on a real
+   *  block hit. A non-block/crosshair miss reports null target fields.
+   */
+  PlayerStatusOption getGmaincraftPlayerStatus(LocalPlayer player) {
+    String blockId = null;
+    int[] blockPos = null;
+    String blockFace = null;
+    float hitDistance = -1f;
+    HitResult hit = client.hitResult;
+    if (client.level != null && hit instanceof BlockHitResult blockHit &&
+        hit.getType() == HitResult.Type.BLOCK) {
+      BlockPos p = blockHit.getBlockPos();
+      blockId = BuiltInRegistries.BLOCK.getKey(
+          client.level.getBlockState(p).getBlock()).toString();
+      blockPos = new int[] {p.getX(), p.getY(), p.getZ()};
+      blockFace = blockHit.getDirection().getName();
+      hitDistance = (float) player.getEyePosition().distanceTo(hit.getLocation());
+    }
+    return new PlayerStatusOption(
+        "gmaincraft_status_v1",
+        player.getFoodData().getFoodLevel(),
+        player.getFoodData().getSaturationLevel(),
+        player.getArmorValue(),
+        player.getAirSupply(),
+        player.getInventory().selected,
+        player.level().dimension().location().toString(),
+        blockId, blockPos, blockFace, hitDistance);
+  }
+
+  /** Actual player's client-side block-breaking crack stage. The player
+   *  can see the progressive crack overlay while mining in vanilla. This
+   *  reading is attached to the current MCio observation, not a trainer's
+   *  guess about future block drops. The Java game API returns a stage
+   *  normally from 0 through 9; -1 is our explicit inactive sentinel.
+   */
+  MiningFeedbackOption getGmaincraftMiningFeedback() {
+    boolean active = client.gameMode != null && client.gameMode.isDestroying();
+    int stage = active ? client.gameMode.getDestroyStage() : -1;
+    boolean targeted = client.hitResult != null &&
+        client.hitResult.getType() == HitResult.Type.BLOCK;
+    return new MiningFeedbackOption("gmaincraft_mining_feedback_v1",
+        active, stage, targeted);
+  }
+
+  /** BOUNDED research-only camera sample grid; no iteration over chunks,
+   *  no wall penetration, and no world seed or generator knowledge. Occluding
+   *  collidable blocks (including glass) stop each ray. Fluid NONE means
+   *  water and non-collidable decorations need future experiments. This is
+   *  an approximation of projection, NOT a validated visual detector.
+   */
+  SurfaceGridOption getGmaincraftSurfaceGrid(LocalPlayer player) {
+    // Research profile is a bounded, explicit experimental setting. Stable
+    // default stays 13x9. "fine" increases sampling to 25x17 (425 rays),
+    // not a free-form radius or loaded-chunk scan. The packet carries shape.
+    final boolean fine = "fine".equals(System.getenv("GMAINCRAFT_SURFACE_RAY_PROFILE"));
+    final int columns = fine ? 25 : 13;
+    final int rows = fine ? 17 : 9;
+    final float vfov = (float)(int)client.options.fov().get();
+    final double aspect = (double)client.getWindow().getWidth() /
+        Math.max(1,client.getWindow().getHeight());
+    final double tanV = Math.tan(Math.toRadians(vfov) * 0.5);
+    final double tanH = tanV * aspect;
+    // Use the game's own current render distance, NOT all loaded chunks.
+    final float limit = 16f * client.options.renderDistance().get();
+    Vec3 eye = player.getEyePosition();
+    Vec3 forward = player.getViewVector(1f).normalize();
+    Vec3 right = forward.cross(new Vec3(0,1,0));
+    // At exactly +/-90 pitch, forward is vertical and its cross product
+    // with world up is ZERO. Use a yaw-aligned horizontal camera axis so
+    // samples do not collapse to a single ray when looking straight up/down.
+    if (right.lengthSqr() < 1.0e-8) {
+      double yaw = Math.toRadians(player.getYRot());
+      right = new Vec3(-Math.cos(yaw),0,-Math.sin(yaw));
+    } else {
+      right = right.normalize();
+    }
+    Vec3 up = right.cross(forward).normalize();
+    ArrayList<SurfaceRayHit> hits = new ArrayList<>();
+    if (client.level != null) {
+      for (int row = 0; row < rows; row++) {
+        double y = 1.0 - (row + .5) * 2.0 / rows;
+        for (int col = 0; col < columns; col++) {
+          double x = (col + .5) * 2.0 / columns - 1.0;
+          Vec3 direction = forward.add(right.scale(x * tanH))
+              .add(up.scale(y * tanV)).normalize();
+          BlockHitResult hit = client.level.clip(new ClipContext(
+              eye, eye.add(direction.scale(limit)),
+              ClipContext.Block.COLLIDER, ClipContext.Fluid.NONE, player));
+          if (hit.getType() != HitResult.Type.BLOCK) continue;
+          BlockPos p = hit.getBlockPos();
+          // Guard against a ray ending in unloaded/unrendered data.
+          if (!client.level.hasChunkAt(p)) continue;
+          String id = BuiltInRegistries.BLOCK.getKey(
+              client.level.getBlockState(p).getBlock()).toString();
+          hits.add(new SurfaceRayHit(row*columns+col, id,
+              new int[]{p.getX(),p.getY(),p.getZ()},
+              hit.getDirection().getName(),
+              (float)eye.distanceTo(hit.getLocation()),
+              client.level.getBrightness(LightLayer.SKY,p),
+              client.level.getBrightness(LightLayer.BLOCK,p)));
+        }
+      }
+    }
+    return new SurfaceGridOption("gmaincraft_surface_grid_v0",
+        columns, rows, vfov, limit, hits);
+  }
+
+  private static final class SurfaceAccumulator {
+    final SurfaceRayHit first;
+    final ArrayList<Integer> rays = new ArrayList<>();
+    int faceMask = 0;
+    float nearestDistance;
+
+    SurfaceAccumulator(SurfaceRayHit initial) {
+      first = initial;
+      nearestDistance = initial.distance();
+    }
+
+    void add(SurfaceRayHit hit) {
+      rays.add(hit.ray_index());
+      nearestDistance = Math.min(nearestDistance, hit.distance());
+      faceMask |= switch (hit.face()) {
+        case "down" -> 1;
+        case "up" -> 2;
+        case "north" -> 4;
+        case "south" -> 8;
+        case "west" -> 16;
+        case "east" -> 32;
+        default -> throw new IllegalArgumentException("Unexpected hit face");
+      };
+    }
+
+    SurfaceObjectHit finish() {
+      return new SurfaceObjectHit(first.block_id(), first.block_pos(), faceMask,
+          nearestDistance, first.sky_light(), first.block_light(),
+          rays.stream().mapToInt(Integer::intValue).toArray());
+    }
+  }
+
+  /** Condense identical visible block positions into sample-coverage sets.
+   *  The first-hit ray evidence is unchanged; no additional world reads.
+   *  This grouping does NOT yet prove human-visual eligibility.
+   */
+  SurfaceObjectsOption getGmaincraftSurfaceObjects(SurfaceGridOption grid) {
+    Map<BlockPos, SurfaceAccumulator> seen = new LinkedHashMap<>();
+    for (SurfaceRayHit hit : grid.hits()) {
+      int[] coords = hit.block_pos();
+      BlockPos key = new BlockPos(coords[0], coords[1], coords[2]);
+      SurfaceAccumulator value = seen.computeIfAbsent(key,
+          unused -> new SurfaceAccumulator(hit));
+      value.add(hit);
+    }
+    ArrayList<SurfaceObjectHit> objects = new ArrayList<>();
+    for (SurfaceAccumulator value : seen.values()) objects.add(value.finish());
+    return new SurfaceObjectsOption("gmaincraft_surface_objects_v1",
+        grid.columns(),grid.rows(),grid.vertical_fov_degrees(),
+        grid.max_distance(),objects);
+  }
+
+  /** Experimental item-sprite camera visibility sensor, NOT action reach.
+   * Each candidate must project inside the camera frustum and have an
+   * unobstructed engine VISUAL ray to at least one of 5 item-box samples.
+   * Nothing about outside-frustum / occluded items reaches the Python actor.
+   * Small sprites less than ~2 pixels are intentionally unreported rather
+   * than awarding a supernatural exact distant item registry ID.
+   * Glass/leaves/partial shapes remain a documented CALIBRATION gap.
+   */
+  VisibleItemsOption getGmaincraftVisibleItems(LocalPlayer player) {
+    final float maxDistance = Math.min(24f, 16f * client.options.renderDistance().get());
+    ArrayList<VisibleItemHit> visible = new ArrayList<>();
+    if (client.level == null) return new VisibleItemsOption("gmaincraft_visible_items_v1",maxDistance,visible);
+    Vec3 eye = player.getEyePosition();
+    Vec3 forward = player.getViewVector(1f).normalize();
+    Vec3 right = forward.cross(new Vec3(0,1,0));
+    if (right.lengthSqr() < 1.0e-8) {
+      double yaw = Math.toRadians(player.getYRot());
+      right = new Vec3(-Math.cos(yaw),0,-Math.sin(yaw));
+    } else right = right.normalize();
+    Vec3 up = right.cross(forward).normalize();
+    double tanV = Math.tan(Math.toRadians(client.options.fov().get())*0.5);
+    double aspect = (double)client.getWindow().getWidth()/Math.max(1,client.getWindow().getHeight());
+    double tanH=tanV*aspect;
+    double pixelsPerVertical = Math.max(1,client.getWindow().getHeight());
+    for (ItemEntity item : client.level.getEntitiesOfClass(ItemEntity.class,
+            new AABB(eye.x-24,eye.y-24,eye.z-24,eye.x+24,eye.y+24,eye.z+24),
+            entity -> entity.isAlive() && !entity.getItem().isEmpty())) {
+      AABB bounds = item.getBoundingBox();
+      Vec3 center = bounds.getCenter();
+      Vec3 offset = center.subtract(eye);
+      double depth = offset.dot(forward);
+      if (depth<=0.05 || depth>maxDistance || tanV<=0 || tanH<=0) continue;
+      double sx=offset.dot(right)/depth/tanH;
+      double sy=offset.dot(up)/depth/tanV;
+      double visibleHeight=Math.max(bounds.getYsize(),bounds.getXsize());
+      if (Math.max(bounds.getXsize()/depth/tanH * client.getWindow().getWidth()/2,
+                   visibleHeight/depth/tanV * pixelsPerVertical/2)<2.0) continue;
+      // Offset a bounding-box pixel/quad sample in directions visible to the
+      // camera, not arbitrary hidden corners of an item entity.
+      double halfX=bounds.getXsize()*0.40;
+      double halfY=bounds.getYsize()*0.40;
+      Vec3[] samples={center,
+          center.add(right.scale(halfX)),center.add(right.scale(-halfX)),
+          center.add(up.scale(halfY)),center.add(up.scale(-halfY))};
+      int exposed=0;
+      for (Vec3 sample:samples) {
+        Vec3 displacement=sample.subtract(eye);
+        double d=displacement.dot(forward);
+        if (d<=0 || d>maxDistance) continue;
+        double projectedX=displacement.dot(right)/d/tanH;
+        double projectedY=displacement.dot(up)/d/tanV;
+        if (Math.abs(projectedX)>1 || Math.abs(projectedY)>1) continue;
+        BlockHitResult blocker=client.level.clip(new ClipContext(
+            eye,sample,ClipContext.Block.VISUAL,ClipContext.Fluid.NONE,player));
+        if (blocker.getType()!=HitResult.Type.MISS &&
+            eye.distanceTo(blocker.getLocation())+0.005<eye.distanceTo(sample)) continue;
+        exposed++;
+      }
+      if (exposed==0) continue;
+      String id=BuiltInRegistries.ITEM.getKey(item.getItem().getItem()).toString();
+      visible.add(new VisibleItemHit(id,
+          new float[]{(float)center.x,(float)center.y,(float)center.z},
+          (float)offset.length(),(float)(sx*.5+.5),(float)(.5-sy*.5),exposed));
+    }
+    visible.sort((a,b)->Float.compare(a.distance(),b.distance()));
+    if (visible.size()>16) visible.subList(16,visible.size()).clear();
+    return new VisibleItemsOption("gmaincraft_visible_items_v1",maxDistance,visible);
+  }
